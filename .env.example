# ---------------------------------------------------------------
# Autonomous PC Agent - environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# Identity
AGENT_NAME=PC Agent
AGENT_ID=

# Telegram (owner allowlist = numeric user IDs, comma-separated)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
OWNER_TELEGRAM_IDS=123456789,987654321
TELEGRAM_MODE=polling          # polling | webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443

# Relay / server (empty => standalone local mode)
RELAY_URL=                   # e.g. https://pc-agent-relay.onrender.com
RELAY_API_KEY=
RELAY_HEARTBEAT_INTERVAL=30
RELAY_RECONNECT_INTERVAL=5

# LLM brain (provider-agnostic). REQUIRED: the agent is LLM-only, there is no
# rule-based planner. Without LLM_API_KEY tasks fail with a clear error.
LLM_PROVIDER=openai           # openai | anthropic | custom
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_ENABLE_VISION=true        # attach a screenshot to every reasoning turn (falls back to text if rejected)

# Reasoning loop: the LLM is called repeatedly, seeing
# the result of every action, until the task is done.
AGENT_MAX_ITERATIONS=0         # max LLM turns per task; 0 = unlimited (runs until the task is done)
AGENT_MAX_ACTIONS_PER_TURN=3   # actions the LLM may batch in one turn
AGENT_HISTORY_WINDOW=8         # recent actions shown in full (older ones are compressed)
AGENT_OBSERVE_OCR=true         # add OCR screen text to each observation (needs Tesseract)

# Task engine
TASK_DB_PATH=data/agent.db
TASK_EXECUTION_TIMEOUT=3600
STUCK_STATE_THRESHOLD=120
MAX_RETRIES=3
RETRY_BASE_BACKOFF=2

# Desktop control
DESKTOP_INPUT_LOCK=true
SCREENSHOT_QUALITY=70
SCREENSHOT_MAX_DIMENSION=1920
PYAUTOGUI_PAUSE=0.1
PYAUTOGUI_FAILSAFE=true

# Screen capture / streaming
SCREEN_CAPTURE_FPS=5
SCREEN_CAPTURE_QUALITY=60
SCREEN_CAPTURE_MONITOR=0
SCREEN_CAPTURE_ENABLED=true
STREAMING_INDICATOR=true

# Filesystem safety
FILE_DELETE_TO_RECYCLE_BIN=true
BACKUP_BEFORE_MODIFY=true
MAX_RECURSIVE_DEPTH=10

# Windows runtime
AUTO_STARTUP=true
EMERGENCY_STOP_HOTKEY=ctrl+alt+shift+x
WATCHDOG_ENABLED=true

# Paths
DATA_DIR=data
LOGS_DIR=logs
RECORDINGS_DIR=data/recordings
SCREENSHOTS_DIR=data/screenshots

# Server
RENDER=false
PORT=8000

# Desktop profile injected into the agent system prompt (default: agent/profile/desktop_profile.md)
DESKTOP_PROFILE_PATH=
