# ---------------------------------------------------------------
# Autonomous PC Agent - environment configuration
# ---------------------------------------------------------------

# Identity
AGENT_NAME=PC Agent
AGENT_ID=

# Telegram (owner allowlist = numeric user IDs, comma-separated)
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443

# Relay / server (empty => standalone local mode)
RELAY_URL=
RELAY_API_KEY=
RELAY_HEARTBEAT_INTERVAL=30
RELAY_RECONNECT_INTERVAL=5

# LLM brain (provider-agnostic) - configured via APIRouter
LLM_PROVIDER=openai
LLM_API_KEY=sk-router-6cc889b3de2e1879dee2c405ee0265affcf03cef6d869c20
LLM_BASE_URL=https://apirouter-wn25.onrender.com/v1
LLM_MODEL=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_ENABLE_VISION=true

# Task engine
TASK_DB_PATH=data/agent.db
TASK_EXECUTION_TIMEOUT=3600
STUCK_STATE_THRESHOLD=120
MAX_RETRIES=3
RETRY_BASE_BACKOFF=2

# Desktop control
DESKTOP_INPUT_LOCK=true
SCREENSHOT_QUALITY=70
SCREENSHOT_MAX_DIMENSION=1920
PYAUTOGUI_PAUSE=0.1
PYAUTOGUI_FAILSAFE=true

# Screen capture / streaming
SCREEN_CAPTURE_FPS=5
SCREEN_CAPTURE_QUALITY=60
SCREEN_CAPTURE_MONITOR=0
SCREEN_CAPTURE_ENABLED=true
STREAMING_INDICATOR=true

# Filesystem safety
FILE_DELETE_TO_RECYCLE_BIN=true
BACKUP_BEFORE_MODIFY=true
MAX_RECURSIVE_DEPTH=10

# Windows runtime
AUTO_STARTUP=true
EMERGENCY_STOP_HOTKEY=ctrl+alt+shift+x
WATCHDOG_ENABLED=true

# Paths
DATA_DIR=data
LOGS_DIR=logs
RECORDINGS_DIR=data/recordings
SCREENSHOTS_DIR=data/screenshots

# Server
RENDER=false
PORT=8000
